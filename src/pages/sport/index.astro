<script>
  const PLAN_START = new Date('2026-08-03');
  const PLAN_END   = new Date('2027-10-17');
  const today = new Date();
  today.setHours(0,0,0,0);

  const totalMs = PLAN_END.getTime() - PLAN_START.getTime();
  const elapsedMs = today.getTime() - PLAN_START.getTime();
  const pct = Math.max(0, Math.min(100, (elapsedMs / totalMs) * 100));
  const weekNum = Math.max(0, Math.floor(elapsedMs / (7 * 86400000)) + 1);

  // ── Current phase detection & auto-open ──
  const bars = document.querySelectorAll<HTMLElement>('.phase-bar');
  let currentPhaseId: string | null = null;

  bars.forEach(bar => {
    const start = new Date(bar.dataset.start!);
    const end = new Date(bar.dataset.end!);
    if (today >= start && today <= end) {
      bar.classList.add('current');
      currentPhaseId = bar.dataset.phase!;
    }
  });

  // Phase week ranges (0-indexed) for volume bar highlighting
  const phaseWeekRanges: Record<string, [number, number]> = {
    rehab: [0, 9], skibase: [10, 20], winter: [21, 30], tri703: [31, 43], imspec: [44, 59], taper: [60, 62]
  };
  const phaseRow = document.querySelector('.phase-row')!;
  phaseRow.classList.add('has-active');

  function openPhase(id: string) {
    bars.forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.phase-detail').forEach(d => d.classList.remove('visible'));
    const target = document.querySelector<HTMLElement>(`.phase-bar[data-phase="${id}"]`);
    target?.classList.add('active');
    document.getElementById('detail-' + id)?.classList.add('visible');

    // Dim volume bars outside the active phase
    const [start, end] = phaseWeekRanges[id] || [0, 62];
    document.querySelectorAll<HTMLElement>('.vb').forEach((vb, i) => {
      vb.style.opacity = (i >= start && i <= end) ? '1' : '.25';
      vb.style.transition = 'opacity .2s';
    });
  }

  // Auto-open current phase (or default to first)
  openPhase(currentPhaseId || 'rehab');

  // Click handlers
  bars.forEach(bar => {
    bar.addEventListener('click', () => {
      openPhase(bar.dataset.phase!);
    });
  });

  // ── Today needle ──
  const needle = document.getElementById('todayNeedle')!;
  const label = document.getElementById('todayLabel')!;
  const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const dateStr = `${today.getDate()} ${monthNames[today.getMonth()]}`;

  if (today < PLAN_START || today > PLAN_END) {
    needle.style.display = 'none';
  } else {
    needle.style.left = `calc(1.4rem + (100% - 2.8rem) * ${pct / 100})`;
    label.textContent = `${dateStr} · Wk ${weekNum}`;
  }

  // ── Volume chart (deterministic weekly hours) ──
  (function() {
    const phases: { name: string; color: string; vols: number[] }[] = [
      { name: 'Rehab & Rebuild', color: '#4c8c7d', vols: [5, 5.5, 6, 4.5, 6.5, 7, 7.5, 5.5, 7.5, 8] },
      { name: 'Ski Base',        color: '#2b6cb0', vols: [8, 8.5, 9, 6.5, 9.5, 10, 10.5, 7, 10.5, 11, 9] },
      { name: 'Winter Races',    color: '#5a4ec9', vols: [9, 9.5, 6, 6, 9.5, 10, 9, 9, 6.5, 4.5] },
      { name: '70.3 Build',      color: '#22804a', vols: [5.5, 8, 9, 6.5, 10, 10.5, 11, 7, 10.5, 11, 9.5, 7.5, 5.5] },
      { name: 'IM Specific',     color: '#c05525', vols: [8, 11, 12.5, 9, 13, 13.5, 14, 10, 13.5, 14, 14.5, 10.5, 14, 15, 13.5, 11] },
      { name: 'Peak & Taper',    color: '#943064', vols: [9.5, 6.5, 4] },
    ];
    const races: Record<number, {color: string; label: string}> = {
      2:  {color:'#111110', label:'Sprint Triathlon'},
      23: {color:'#111110', label:'La Diagonela'},
      30: {color:'#111110', label:'Vasaloppet'},
      43: {color:'#111110', label:'Ironman 70.3 Rapperswil'},
      62: {color:'#111110', label:'Ironman Port Macquarie'},
    };
    const maxH = 80, maxV = 16;
    const container = document.getElementById('volBars');
    if (!container) return;
    let wi = 0;

    function fmtDate(d: Date) {
      return `${d.getDate()} ${monthNames[d.getMonth()]}`;
    }

    phases.forEach(ph => {
      const mean = ph.vols.reduce((a, b) => a + b, 0) / ph.vols.length;
      ph.vols.forEach(vol => {
        const isRace = !!races[wi];
        const isDeload = !isRace && vol < mean * 0.82;
        const h = Math.round((Math.max(3, Math.min(16, vol)) / maxV) * maxH);

        const wkStart = new Date(PLAN_START.getTime() + wi * 7 * 86400000);
        const wkEnd = new Date(wkStart.getTime() + 6 * 86400000);

        const wrap = document.createElement('div');
        wrap.className = 'vb';
        wrap.title = `Wk ${wi+1} · ${fmtDate(wkStart)}–${fmtDate(wkEnd)}\n~${vol.toFixed(1)} hrs · ${ph.name}${isRace ? ' · race' : isDeload ? ' (recovery)' : ''}`;

        const bar = document.createElement('div');
        bar.className = 'vbar' + (isDeload ? ' dl' : '');
        bar.style.cssText = `height:${h}px;background:${ph.color}`;
        wrap.appendChild(bar);

        if (races[wi]) {
          const r = races[wi];
          const mk = document.createElement('div');
          mk.className = 'race-marker';
          mk.title = r.label;
          const dot = document.createElement('div');
          dot.className = 'rm-dot';
          dot.style.background = r.color;
          const line = document.createElement('div');
          line.className = 'rm-line';
          line.style.cssText = `background:${r.color};height:${h-8}px`;
          mk.appendChild(dot);
          mk.appendChild(line);
          wrap.appendChild(mk);
        }

        container.appendChild(wrap);
        wi++;
      });
    });
  })();
</script>

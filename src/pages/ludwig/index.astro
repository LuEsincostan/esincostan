---
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = [
  {
    title: "Rollerski Routes",
    description: "Find the best rollerski routes around Wädenswil & Zurich",
    href: "/rollerski",
    status: "In progress",
  },
  {
    title: "Sport & Fitness",
    description: "2026/27 dual season — Vasaloppet & La Diagonela on snow, then Ironman in Port Macquarie",
    href: "/sport",
    status: "In progress",
  },
];
---

<BaseLayout title="Ludwig — Projects" description="Projects by Ludwig Ehlert">
  <main class="person-landing">
    <header class="person-header">
      <a href="/" class="person-back">&larr; esincostan</a>
      <div class="person-header-row">
        <h1 class="person-heading">Ludwig</h1>
        <nav class="person-tabs">
          <a href="/ludwig" class="person-tab person-tab--active">Projects</a>
          <a href="/ludwig/about" class="person-tab">About</a>
        </nav>
      </div>
    </header>

    <section class="projects-grid">
      {projects.map((project) => (
        <a href={project.href} class="project-card">
          <h2>{project.title}</h2>
          <p>{project.description}</p>
          <span class="project-status">{project.status}</span>
        </a>
      ))}
    </section>
  </main>
</BaseLayout>

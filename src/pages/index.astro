---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="esincostan" description="Projects by Andra & Ludwig">
  <main class="landing">
    <header class="landing-header">
      <h1>esincostan</h1>
    </header>

    <div class="persons">
      <div class="person-column person-column--left">
        <p class="person-name">Andra</p>
        <nav class="person-nav">
          <a href="/andra" class="person-nav-link">
            <span class="nav-dot"></span>Projects
          </a>
          <a href="/andra/about" class="person-nav-link">
            <span class="nav-dot"></span>About
          </a>
        </nav>
      </div>

      <div class="person-divider" aria-hidden="true"></div>

      <div class="person-column person-column--right">
        <p class="person-name">Ludwig</p>
        <nav class="person-nav">
          <a href="/ludwig" class="person-nav-link">
            <span class="nav-dot"></span>Projects
          </a>
          <a href="/ludwig/about" class="person-nav-link">
            <span class="nav-dot"></span>About
          </a>
        </nav>
      </div>
    </div>
  </main>
</BaseLayout>

<style>
  .landing {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 2rem;
  }

  .landing-header {
    text-align: center;
    margin-bottom: 3.5rem;
  }

  .landing-header h1 {
    font-family: var(--font-mono);
    font-size: clamp(1.8rem, 4.5vw, 2.8rem);
    font-weight: 700;
    color: var(--forest);
    letter-spacing: -0.02em;
  }

  .persons {
    display: grid;
    grid-template-columns: 1fr 1px 1fr;
    max-width: 560px;
    width: 100%;
  }

  .person-divider {
    background: var(--sand);
    align-self: stretch;
    min-height: 100px;
  }

  .person-column {
    padding: 0.5rem 3rem 0.5rem;
    display: flex;
    flex-direction: column;
  }

  .person-column--left { align-items: flex-end; }
  .person-column--right { align-items: flex-start; }

  .person-name {
    font-size: 2rem;
    font-weight: 700;
    color: var(--forest);
    letter-spacing: -0.02em;
    margin-bottom: 1rem;
  }

  .person-nav {
    display: flex;
    flex-direction: column;
    gap: 0.55rem;
  }

  .person-nav-link {
    display: flex;
    align-items: center;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--text-dim);
    text-decoration: none;
    transition: color 150ms ease;
  }

  .person-nav-link:hover {
    color: var(--forest);
  }

  .person-nav-link:hover .nav-dot {
    background: var(--forest);
  }

  .nav-dot {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--lake-light);
    flex-shrink: 0;
    transition: background 150ms ease;
  }

  @media (max-width: 480px) {
    .persons {
      grid-template-columns: 1fr;
      max-width: 240px;
    }

    .person-divider {
      height: 1px;
      min-height: 0;
      width: 100%;
      margin: 1.8rem 0;
    }

    .person-column--left,
    .person-column--right {
      align-items: flex-start;
      padding: 0 0.5rem;
    }
  }
</style>

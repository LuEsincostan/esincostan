---
import BaseLayout from "../../layouts/BaseLayout.astro";
---

<BaseLayout title="Doublepole Vasaloppet — Training Plan" description="46-week training plan for Vasaloppet 2027, La Diagonela & Marcialonga">
  <div class="vl">
    <header>
      <div>
        <a href="/" class="back-link">&larr; esincostan</a>
        <p class="eyebrow">Season plan · Advanced competitor · 3 races</p>
        <h1>Doublepole Vasaloppet</h1>
      </div>
      <div class="header-right">
        <strong>7 Mar 2027</strong>
        Vasaloppet · Sälen &rarr; Mora · 90 km<br>
        Plan start: 20 Apr 2026<br>
        46 weeks · 7–10 hrs / week
      </div>
    </header>

    <main>
      <!-- Stats -->
      <section>
        <p class="section-label">Season at a glance</p>
        <div class="stat-row">
          <div class="stat-cell"><div class="stat-value">46</div><div class="stat-label">Weeks of preparation</div></div>
          <div class="stat-cell"><div class="stat-value">3</div><div class="stat-label">Race events</div></div>
          <div class="stat-cell"><div class="stat-value">215</div><div class="stat-label">Race kilometres total</div></div>
          <div class="stat-cell"><div class="stat-value">~18k</div><div class="stat-label">DP strokes in Vasaloppet</div></div>
        </div>
      </section>

      <!-- Race Calendar -->
      <section>
        <p class="section-label">Race calendar</p>
        <div class="race-calendar">
          <div class="race-card diagonela">
            <div class="race-num">Race 01</div>
            <div class="race-name">Engadin<br>La Diagonela</div>
            <div class="race-date">~17 Jan 2027 · Pontresina &rarr; Zuoz</div>
            <div class="race-meta">
              55 km · Classic technique<br>
              1 800 m altitude · Engadin Valley, CH<br>
              Ski Classics Pro Tour
            </div>
            <span class="race-badge badge-tunea">Tune-up race</span>
            <div class="race-gap"><strong>49 days</strong> before Vasaloppet</div>
          </div>

          <div class="race-card marcialonga dimmed">
            <div class="race-num">Race 02 — optional</div>
            <div class="race-name">Marcialonga</div>
            <div class="race-date">31 Jan 2027 · Moena &rarr; Cavalese</div>
            <div class="race-meta">
              70 km · Classic technique<br>
              870 m elevation gain · Dolomites, IT<br>
              Ski Classics Grand Classics
            </div>
            <span class="race-badge badge-opt">Decide after Diagonela</span>
            <div class="race-gap"><strong>35 days</strong> before Vasaloppet</div>
          </div>

          <div class="race-card vasaloppet">
            <div class="race-num">Race 03 — main goal</div>
            <div class="race-name">Vasaloppet</div>
            <div class="race-date">7 Mar 2027 · Sälen &rarr; Mora</div>
            <div class="race-meta">
              90 km · Classic technique<br>
              World's largest XC ski race, SE<br>
              Worldloppet / Ski Classics
            </div>
            <span class="race-badge badge-target">Target race</span>
          </div>
        </div>
        <div class="race-note">
          <strong>Race sequencing.</strong> La Diagonela (~Jan 17) sits 49 days out from Vasaloppet — a comfortable tune-up window. Run it as a controlled effort, not an all-out performance; the goal is race feel and confidence, not a result. <strong>Marcialonga (Jan 31)</strong> is the harder call at 35 days out. It is doable but demands clean recovery from Diagonela and treating it as a sustained training effort at race pace rather than full competition. Decide only after you see your Diagonela recovery. If you race both, the Feb 21 taper start is non-negotiable — your body will have raced 215 km in 7 weeks.
        </div>
      </section>

      <!-- Phase Timeline -->
      <section>
        <p class="section-label">Season structure — click a phase to expand</p>
        <div class="timeline">
          <div class="phase-block base active" data-phase="base" data-start="2026-04-20" data-end="2026-06-28">
            <div class="phase-num">01</div>
            <div class="phase-name">Aerobic Base</div>
            <div class="phase-dates">20 Apr – 28 Jun 2026</div>
            <div class="phase-vol">6 – 8 hrs / wk</div>
          </div>
          <div class="phase-block build" data-phase="build" data-start="2026-06-29" data-end="2026-09-27">
            <div class="phase-num">02</div>
            <div class="phase-name">Strength &amp; Volume</div>
            <div class="phase-dates">29 Jun – 27 Sep 2026</div>
            <div class="phase-vol">7 – 9 hrs / wk</div>
          </div>
          <div class="phase-block snow" data-phase="snow" data-start="2026-09-28" data-end="2026-12-27">
            <div class="phase-num">03</div>
            <div class="phase-name">On-Snow Transition</div>
            <div class="phase-dates">28 Sep – 27 Dec 2026</div>
            <div class="phase-vol">7 – 9 hrs / wk</div>
          </div>
          <div class="phase-block peak" data-phase="peak" data-start="2026-12-28" data-end="2027-02-20">
            <div class="phase-num">04</div>
            <div class="phase-name">Race Sharpening</div>
            <div class="phase-dates">28 Dec – 20 Feb 2027</div>
            <div class="phase-vol">7 – 8 hrs / wk</div>
            <div class="phase-flags">
              <span class="flag dia">Diagonela ~Jan 17</span>
              <span class="flag mar">Marcialonga Jan 31*</span>
            </div>
          </div>
          <div class="phase-block taper" data-phase="taper" data-start="2027-02-21" data-end="2027-03-07">
            <div class="phase-num">05</div>
            <div class="phase-name">Taper</div>
            <div class="phase-dates">21 Feb – 7 Mar</div>
            <div class="phase-vol">4 – 5 hrs / wk</div>
            <div class="phase-flags">
              <span class="flag vas">Vasaloppet Mar 7</span>
            </div>
          </div>
        </div>

        <!-- Progress bar -->
        <div class="progress-track" id="progressTrack">
          <div class="progress-fill" id="progressFill"></div>
          <div class="progress-needle" id="progressNeedle">
            <div class="needle-line"></div>
            <div class="needle-label" id="needleLabel"></div>
          </div>
        </div>

        <div class="phase-detail visible" id="detail-base">
          <div class="dc">
            <div class="dl">Intensity split</div>
            <div class="zone-row"><span class="zlbl">Z1</span><div class="ztrack"><div class="zfill z1f" style="width:80%"></div></div><span class="zpct">80%</span></div>
            <div class="zone-row"><span class="zlbl">Z2</span><div class="ztrack"><div class="zfill z2f" style="width:15%"></div></div><span class="zpct">15%</span></div>
            <div class="zone-row"><span class="zlbl">Z3</span><div class="ztrack"><div class="zfill z3f" style="width:5%"></div></div><span class="zpct">5%</span></div>
            <div style="margin-top:1.2rem"><div class="dl">Primary sports</div>
              <div class="pills"><span class="pill p">Cycling</span><span class="pill p">Hiking</span><span class="pill p">Running</span><span class="pill">Bodyweight</span><span class="pill">Roller ski</span></div>
            </div>
          </div>
          <div class="dc">
            <div class="dl">DP proxy target</div>
            <div class="bignum" style="color:var(--vl-phase-base)">10%</div>
            <div style="font-size:12px;color:var(--vl-ink-3);margin-bottom:1.2rem">of total training hours</div>
            <div class="dl">Microcycle</div>
            <div style="font-size:12px;color:var(--vl-ink-2);line-height:1.7">3 build + 1 recovery (&times;2.5)<br>Recovery = 65% of build vol<br>Max 10% volume increase/wk</div>
          </div>
          <div class="dc">
            <div class="dl">Key focus points</div>
            <ul class="kp">
              <li>Start at 5–6 hrs wk 1, build to 7–8 hrs by end of June</li>
              <li>No roller ski required — aerobic volume, zero technique fatigue</li>
              <li>Establish strength patterns: posterior chain, core, lat pull (2&times;/wk)</li>
              <li>One session &ge; 2 hrs Z1 every week — the non-negotiable anchor</li>
              <li>80% of all minutes below 75% HRmax</li>
            </ul>
          </div>
        </div>

        <div class="phase-detail" id="detail-build">
          <div class="dc">
            <div class="dl">Intensity split</div>
            <div class="zone-row"><span class="zlbl">Z1</span><div class="ztrack"><div class="zfill z1f" style="width:75%"></div></div><span class="zpct">75%</span></div>
            <div class="zone-row"><span class="zlbl">Z2</span><div class="ztrack"><div class="zfill z2f" style="width:18%"></div></div><span class="zpct">18%</span></div>
            <div class="zone-row"><span class="zlbl">Z3</span><div class="ztrack"><div class="zfill z3f" style="width:7%"></div></div><span class="zpct">7%</span></div>
            <div style="margin-top:1.2rem"><div class="dl">Primary sports</div>
              <div class="pills"><span class="pill p">Roller ski</span><span class="pill p">Ski erg</span><span class="pill">Cycling</span><span class="pill">Running</span><span class="pill">Bodyweight</span></div>
            </div>
          </div>
          <div class="dc">
            <div class="dl">DP proxy target</div>
            <div class="bignum" style="color:var(--vl-phase-build)">50%</div>
            <div style="font-size:12px;color:var(--vl-ink-3);margin-bottom:1.2rem">of total training hours</div>
            <div class="dl">Intervals (max 1&times;/week)</div>
            <div style="font-size:12px;color:var(--vl-ink-2);line-height:1.7">5 &times; 8 min at Z3<br>All others strictly Z1<br>Highest overtraining risk phase</div>
          </div>
          <div class="dc">
            <div class="dl">Key focus points</div>
            <ul class="kp">
              <li>Peak annual volume — this block banks the fitness for Vasaloppet</li>
              <li>Classic technique focus on roller ski (race = classic only)</li>
              <li>Double poling volume ramps consistently week over week</li>
              <li>Monitor TSB: target &minus;10 to &minus;30 in build weeks</li>
              <li>2 strength sessions/week, trunk endurance priority</li>
            </ul>
          </div>
        </div>

        <div class="phase-detail" id="detail-snow">
          <div class="dc">
            <div class="dl">Intensity split</div>
            <div class="zone-row"><span class="zlbl">Z1</span><div class="ztrack"><div class="zfill z1f" style="width:70%"></div></div><span class="zpct">70%</span></div>
            <div class="zone-row"><span class="zlbl">Z2</span><div class="ztrack"><div class="zfill z2f" style="width:20%"></div></div><span class="zpct">20%</span></div>
            <div class="zone-row"><span class="zlbl">Z3</span><div class="ztrack"><div class="zfill z3f" style="width:10%"></div></div><span class="zpct">10%</span></div>
            <div style="margin-top:1.2rem"><div class="dl">Primary sports</div>
              <div class="pills"><span class="pill p">XC ski (snow)</span><span class="pill p">Ski erg</span><span class="pill">Roller ski</span><span class="pill">Cycling</span></div>
            </div>
          </div>
          <div class="dc">
            <div class="dl">DP proxy target</div>
            <div class="bignum" style="color:var(--vl-phase-snow)">65%</div>
            <div style="font-size:12px;color:var(--vl-ink-3);margin-bottom:1.2rem">of total training hours</div>
            <div class="dl">Race simulation</div>
            <div style="font-size:12px;color:var(--vl-ink-2);line-height:1.7">1–2 efforts &ge; 90 min at goal pace<br>by December<br>Wax testing sessions begin</div>
          </div>
          <div class="dc">
            <div class="dl">Key focus points</div>
            <ul class="kp">
              <li>Real snow from Nov onward — ski erg fills gaps before that</li>
              <li>DP technique refinement: pole angle, hip drive, cycle length</li>
              <li>First race-pace simulations to build pacing confidence</li>
              <li>Reduce cycling and running — leg freshness matters more now</li>
              <li>Strength drops to 1 session/week</li>
            </ul>
          </div>
        </div>

        <div class="phase-detail" id="detail-peak">
          <div class="dc">
            <div class="dl">Intensity split</div>
            <div class="zone-row"><span class="zlbl">Z1</span><div class="ztrack"><div class="zfill z1f" style="width:65%"></div></div><span class="zpct">65%</span></div>
            <div class="zone-row"><span class="zlbl">Z2</span><div class="ztrack"><div class="zfill z2f" style="width:22%"></div></div><span class="zpct">22%</span></div>
            <div class="zone-row"><span class="zlbl">Z3</span><div class="ztrack"><div class="zfill z3f" style="width:13%"></div></div><span class="zpct">13%</span></div>
            <div style="margin-top:1.2rem"><div class="dl">Primary sports</div>
              <div class="pills"><span class="pill p">XC ski</span><span class="pill p">Ski erg</span><span class="pill">Running (easy)</span></div>
            </div>
          </div>
          <div class="dc">
            <div class="dl">DP proxy target</div>
            <div class="bignum" style="color:var(--vl-phase-peak)">80%</div>
            <div style="font-size:12px;color:var(--vl-ink-3);margin-bottom:1.2rem">of total training hours</div>
            <div class="dl">Races this phase</div>
            <div style="font-size:12px;color:var(--vl-ink-2);line-height:1.9">
              <span style="color:var(--vl-race-a);font-weight:500">La Diagonela ~Jan 17</span> — controlled effort<br>
              <span style="color:var(--vl-race-b);font-weight:500">Marcialonga Jan 31*</span> — decide after Diagonela<br>
              <span style="font-size:11px;color:var(--vl-ink-3)">2–3 &times; 20 min at Vasaloppet pace weekly</span>
            </div>
          </div>
          <div class="dc">
            <div class="dl">Key focus points</div>
            <ul class="kp">
              <li>Volume down, quality up — fewer sessions, higher precision</li>
              <li>La Diagonela: race feel, not a result — 49 days to Vasaloppet</li>
              <li>Marcialonga: only if Diagonela recovery is fully clean</li>
              <li>No new stressors after Dec 28 — trust the summer base</li>
              <li>TSB must trend positive by Feb 21</li>
            </ul>
          </div>
        </div>

        <div class="phase-detail" id="detail-taper">
          <div class="dc">
            <div class="dl">Intensity split</div>
            <div class="zone-row"><span class="zlbl">Z1</span><div class="ztrack"><div class="zfill z1f" style="width:80%"></div></div><span class="zpct">80%</span></div>
            <div class="zone-row"><span class="zlbl">Z2</span><div class="ztrack"><div class="zfill z2f" style="width:15%"></div></div><span class="zpct">15%</span></div>
            <div class="zone-row"><span class="zlbl">Z3</span><div class="ztrack"><div class="zfill z3f" style="width:5%"></div></div><span class="zpct">5%</span></div>
            <div style="margin-top:1.2rem"><div class="dl">Primary sports</div>
              <div class="pills"><span class="pill p">XC ski</span><span class="pill p">Ski erg</span><span class="pill">Easy walking</span></div>
            </div>
          </div>
          <div class="dc">
            <div class="dl">Volume cut</div>
            <div class="bignum" style="color:var(--vl-phase-taper)">&minus;40%</div>
            <div style="font-size:12px;color:var(--vl-ink-3);margin-bottom:1.2rem">from peak sharpening week</div>
            <div class="dl">TSB target race morning</div>
            <div class="bignum" style="font-size:1.8rem">+5 to +20</div>
          </div>
          <div class="dc">
            <div class="dl">Key focus points</div>
            <ul class="kp">
              <li>2–3 short race-pace bursts (30–60 sec) every other day</li>
              <li>No heavy strength, no new physical stressors</li>
              <li>Arrive Mora 2–3 days early — ski first 5 km of course</li>
              <li>Race: start conservative, trust your DP, eat early at feed stations</li>
              <li>Wax testing in February — non-negotiable</li>
            </ul>
          </div>
        </div>
      </section>

      <!-- Weekly Rhythm -->
      <section>
        <p class="section-label">Weekly rhythm — build phase template</p>
        <div class="week-grid">
          <div class="day rest"><div class="dname">Mon</div><div class="ddot dd-r"></div><div class="dtype">Rest</div><div class="ddur">&mdash;</div><div class="dsport">Recovery</div></div>
          <div class="day"><div class="dname">Tue</div><div class="ddot dd-z1"></div><div class="dtype">Long Z1</div><div class="ddur">2 – 3 hrs</div><div class="dsport">Roller ski / cycling</div></div>
          <div class="day"><div class="dname">Wed</div><div class="ddot dd-z1"></div><div class="dtype">Strength + Z1</div><div class="ddur">1 – 1.5 hrs</div><div class="dsport">Bodyweight + ski erg</div></div>
          <div class="day"><div class="dname">Thu</div><div class="ddot dd-z3"></div><div class="dtype">Threshold</div><div class="ddur">1.5 hrs</div><div class="dsport">Roller ski / ski erg<br>5 &times; 8 min Z3</div></div>
          <div class="day rest"><div class="dname">Fri</div><div class="ddot dd-z1"></div><div class="dtype">Easy Z1</div><div class="ddur">1 hr</div><div class="dsport">Running / hiking</div></div>
          <div class="day"><div class="dname">Sat</div><div class="ddot dd-z1"></div><div class="dtype">Long Z1</div><div class="ddur">2.5 – 3 hrs</div><div class="dsport">Roller ski / cycling</div></div>
          <div class="day"><div class="dname">Sun</div><div class="ddot dd-z1"></div><div class="dtype">Medium Z1 + technique</div><div class="ddur">1.5 – 2 hrs</div><div class="dsport">Roller ski / ski erg</div></div>
        </div>
      </section>

      <!-- Volume Chart -->
      <section>
        <p class="section-label">Annual volume — 46 weeks with race markers</p>
        <div class="vol-bars" id="volBars"></div>
        <div class="vol-phase-row">
          <div class="vpl" style="color:var(--vl-phase-base)">Base · 10 wks</div>
          <div class="vpl" style="color:var(--vl-phase-build)">Build · 13 wks</div>
          <div class="vpl" style="color:var(--vl-phase-snow)">Transition · 13 wks</div>
          <div class="vpl" style="color:var(--vl-phase-peak)">Sharpening · 8 wks</div>
          <div class="vpl" style="color:var(--vl-phase-taper)">Taper</div>
        </div>
        <div class="vol-axis"><span>Apr 20</span><span>Jun</span><span>Aug</span><span>Oct</span><span>Dec</span><span>Feb</span><span>Mar 7</span></div>
        <div class="chart-legend">
          <div class="leg-item"><div class="leg-dot" style="background:var(--vl-race-a)"></div>La Diagonela ~Jan 17</div>
          <div class="leg-item"><div class="leg-dot" style="background:var(--vl-race-b)"></div>Marcialonga Jan 31 (optional)</div>
          <div class="leg-item"><div class="leg-dot" style="background:var(--vl-race-c)"></div>Vasaloppet Mar 7</div>
          <div class="leg-item"><div class="leg-dot" style="background:var(--vl-rule);border:1px solid var(--vl-ink-3)"></div>Recovery week</div>
        </div>
      </section>

      <!-- Principles -->
      <section>
        <p class="section-label">Core principles</p>
        <div class="principles">
          <div class="principle"><div class="pnum">01</div><div class="ptitle">Pyramidal intensity</div><div class="pbody">~80% of all time below first lactate threshold. Z2 is the danger zone — the most common mistake is drifting there on easy days. Keep easy genuinely easy.</div></div>
          <div class="principle"><div class="pnum">02</div><div class="ptitle">Double poling first</div><div class="pbody">Vasaloppet is ~18,000 DP strokes. From July, DP-specific training grows from 10% to 80% of volume by race phase. Roller ski, ski erg, real snow all count.</div></div>
          <div class="principle"><div class="pnum">03</div><div class="ptitle">Long session anchor</div><div class="pbody">Every week includes at least one session &ge; 2 hrs at Z1. The most important session of the week. Missing two consecutive is a red flag.</div></div>
          <div class="principle"><div class="pnum">04</div><div class="ptitle">3 + 1 microcycle</div><div class="pbody">Three build weeks, one recovery week (~65% volume). Adaptation happens during recovery — the build only creates the stimulus.</div></div>
          <div class="principle"><div class="pnum">05</div><div class="ptitle">Races as training tools</div><div class="pbody">La Diagonela is a controlled effort inside a training block, not a standalone goal. Marcialonga is only run if Diagonela recovery is clean. Neither should compromise Vasaloppet.</div></div>
          <div class="principle"><div class="pnum">06</div><div class="ptitle">Two-week taper</div><div class="pbody">Volume drops ~40% from Feb 21. Short race-pace bursts maintain sharpness. TSB +5 to +20 on race morning. Arrive Mora 2–3 days early.</div></div>
        </div>
      </section>
    </main>

    <footer>
      <span>Doublepole Vasaloppet · Advanced competitor · v1.2</span>
      <span>20 Apr 2026 – 7 Mar 2027 · 3 race events · intervals.icu compatible</span>
    </footer>
  </div>
</BaseLayout>

<style>
  .vl {
    --vl-ink:   #111110;
    --vl-ink-2: #46453f;
    --vl-ink-3: #7a7972;
    --vl-bg:    #e8e6e1;
    --vl-card:  #ffffff;
    --vl-card-alt: #f8f7f5;
    --vl-rule:  #d5d3cc;
    --vl-shadow: 0 1px 3px rgba(0,0,0,.06), 0 1px 2px rgba(0,0,0,.04);
    --vl-shadow-lg: 0 4px 12px rgba(0,0,0,.07), 0 1px 3px rgba(0,0,0,.05);
    --vl-phase-base:  #2b6cb0;
    --vl-phase-build: #22804a;
    --vl-phase-snow:  #5a4ec9;
    --vl-phase-peak:  #c05525;
    --vl-phase-taper: #943064;
    --vl-race-a: #c05525;
    --vl-race-b: #943064;
    --vl-race-c: #111110;
    --vl-z1: #2b6cb0;
    --vl-z2: #d47e2e;
    --vl-z3: #c03828;
    --vl-font: 'Inter', system-ui, -apple-system, sans-serif;

    font-family: var(--vl-font);
    background: var(--vl-bg);
    color: var(--vl-ink);
    font-size: 15px;
    line-height: 1.6;
    font-weight: 400;
    min-height: 100vh;
  }

  /* HEADER */
  .vl header {
    background: var(--vl-card);
    padding: 4rem 4.5rem 3rem;
    border-bottom: 1px solid var(--vl-rule);
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: 3rem;
    box-shadow: var(--vl-shadow);
  }
  .back-link { display: inline-block; font-size: 12px; font-weight: 500; color: var(--vl-ink-3); text-decoration: none; letter-spacing: .02em; margin-bottom: 1rem; transition: color .15s; }
  .back-link:hover { color: var(--vl-ink); }
  .eyebrow { font-size: 11px; letter-spacing: .2em; text-transform: uppercase; color: var(--vl-ink-3); margin-bottom: .75rem; font-weight: 500; }
  .vl h1 { font-family: var(--vl-font); font-size: clamp(2.6rem,5vw,4.2rem); line-height: 1; font-weight: 700; letter-spacing: -.03em; color: var(--vl-ink); }
  .vl h1 em { font-style: normal; font-weight: 300; color: var(--vl-ink-3); }
  .header-right { text-align: right; color: var(--vl-ink-2); font-size: 13px; line-height: 1.9; font-weight: 400; }
  .header-right strong { display: block; font-family: var(--vl-font); font-size: 2.2rem; font-weight: 700; letter-spacing: -.02em; color: var(--vl-ink); line-height: 1; margin-bottom: .3rem; }

  /* LAYOUT */
  .vl main { max-width: 1160px; margin: 0 auto; padding: 2rem 4.5rem 6rem; }
  .vl section { padding: 2.5rem 0; animation: fadeUp .5s ease both; }
  .vl section:nth-child(1){animation-delay:.05s} .vl section:nth-child(2){animation-delay:.1s}
  .vl section:nth-child(3){animation-delay:.15s} .vl section:nth-child(4){animation-delay:.2s}
  .vl section:nth-child(5){animation-delay:.25s} .vl section:nth-child(6){animation-delay:.3s}
  @keyframes fadeUp { from{opacity:0;transform:translateY(14px)} to{opacity:1;transform:translateY(0)} }

  .section-label { font-size: 10px; letter-spacing: .2em; text-transform: uppercase; color: var(--vl-ink-3); font-weight: 500; margin-bottom: 1.2rem; }

  /* STAT ROW */
  .stat-row { display: grid; grid-template-columns: repeat(4,1fr); gap: 1px; background: var(--vl-rule); border-radius: 8px; overflow: hidden; box-shadow: var(--vl-shadow); }
  .stat-cell { background: var(--vl-card); padding: 1.6rem 1.4rem; }
  .stat-value { font-family: var(--vl-font); font-size: 2.2rem; font-weight: 700; letter-spacing: -.02em; line-height: 1; margin-bottom: .3rem; color: var(--vl-ink); }
  .stat-label { font-size: 11px; color: var(--vl-ink-3); letter-spacing: .06em; font-weight: 500; }

  /* RACE CALENDAR */
  .race-calendar { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: var(--vl-rule); border-radius: 8px 8px 0 0; overflow: hidden; box-shadow: var(--vl-shadow); }
  .race-card { background: var(--vl-card); padding: 1.8rem 1.6rem; position: relative; }
  .race-card::before { content:''; position:absolute; top:0; left:0; right:0; height:4px; }
  .race-card.diagonela::before { background: var(--vl-race-a); }
  .race-card.marcialonga::before { background: var(--vl-race-b); }
  .race-card.vasaloppet::before { background: var(--vl-race-c); }
  .race-card.dimmed { opacity: .55; }
  .race-num { font-size: 10px; letter-spacing: .15em; text-transform: uppercase; color: var(--vl-ink-3); margin-bottom: .5rem; font-weight: 500; }
  .race-name { font-family: var(--vl-font); font-size: 1.3rem; font-weight: 700; letter-spacing: -.01em; line-height: 1.15; margin-bottom: .4rem; color: var(--vl-ink); }
  .race-date { font-size: 13px; color: var(--vl-ink-2); margin-bottom: .8rem; }
  .race-meta { font-size: 12.5px; color: var(--vl-ink-3); line-height: 1.7; margin-bottom: 1rem; }
  .race-badge { display: inline-block; font-size: 10px; letter-spacing: .1em; text-transform: uppercase; padding: .25rem .7rem; border-radius: 4px; font-weight: 500; }
  .badge-tunea  { background: #fef3ec; color: var(--vl-race-a); }
  .badge-opt    { background: #f0edfb; color: var(--vl-phase-snow); }
  .badge-target { background: var(--vl-ink); color: #fff; }
  .race-gap { font-size: 12px; color: var(--vl-ink-3); margin-top: .6rem; }
  .race-gap strong { color: var(--vl-ink-2); font-weight: 600; }

  .race-note {
    background: var(--vl-card-alt);
    border: 1px solid var(--vl-rule);
    border-top: none;
    border-radius: 0 0 8px 8px;
    padding: 1.2rem 1.6rem;
    font-size: 13px;
    color: var(--vl-ink-2);
    line-height: 1.7;
    box-shadow: var(--vl-shadow);
  }
  .race-note strong { color: var(--vl-ink); font-weight: 600; }

  /* PHASE TIMELINE */
  .timeline { display: grid; grid-template-columns: 10fr 13fr 13fr 8fr 2fr; gap: 1px; background: var(--vl-rule); border-radius: 8px 8px 0 0; overflow: visible; box-shadow: var(--vl-shadow); }
  .phase-block { background: var(--vl-card); padding: 1.4rem 1rem; cursor: pointer; transition: background .15s; border-bottom: 3px solid transparent; }
  .phase-block:hover { background: var(--vl-card-alt); }
  .phase-block.active { background: var(--vl-card-alt); }
  .phase-block.base.active,.phase-block.base:hover { border-bottom-color: var(--vl-phase-base); }
  .phase-block.build.active,.phase-block.build:hover { border-bottom-color: var(--vl-phase-build); }
  .phase-block.snow.active,.phase-block.snow:hover { border-bottom-color: var(--vl-phase-snow); }
  .phase-block.peak.active,.phase-block.peak:hover { border-bottom-color: var(--vl-phase-peak); }
  .phase-block.taper.active,.phase-block.taper:hover { border-bottom-color: var(--vl-phase-taper); }
  .phase-num { font-size: 10px; letter-spacing: .15em; text-transform: uppercase; color: var(--vl-ink-3); margin-bottom: .3rem; font-weight: 500; }
  .phase-name { font-family: var(--vl-font); font-size: 1rem; font-weight: 600; line-height: 1.2; margin-bottom: .35rem; color: var(--vl-ink); }
  .phase-dates { font-size: 11px; color: var(--vl-ink-3); margin-bottom: .35rem; }
  .phase-vol { font-size: 12px; color: var(--vl-ink-2); }
  .phase-flags { display: flex; flex-wrap: wrap; gap: 4px; margin-top: .5rem; }
  .flag { font-size: 9px; letter-spacing: .06em; text-transform: uppercase; padding: 2px 6px; border-radius: 3px; font-weight: 500; }
  .flag.dia { background: #fef3ec; color: var(--vl-race-a); }
  .flag.mar { background: #f4eef5; color: var(--vl-race-b); }
  .flag.vas { background: #ebebea; color: var(--vl-race-c); }

  /* PROGRESS TRACK */
  .progress-track {
    position: relative;
    height: 6px;
    background: var(--vl-card);
    border: 1px solid var(--vl-rule);
    border-top: none;
    overflow: visible;
  }
  .progress-fill {
    height: 100%;
    background: var(--vl-ink-3);
    transition: width .4s ease;
  }
  .progress-needle {
    position: absolute;
    top: -2px;
    transform: translateX(-50%);
    display: flex;
    flex-direction: column;
    align-items: center;
    pointer-events: none;
    z-index: 1;
  }
  .needle-line {
    width: 2px;
    height: 10px;
    background: var(--vl-ink);
    border-radius: 1px;
  }
  .needle-label {
    margin-top: 4px;
    font-size: 10px;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: var(--vl-ink);
    font-weight: 600;
    white-space: nowrap;
    background: var(--vl-card);
    padding: 2px 8px;
    border-radius: 4px;
    border: 1px solid var(--vl-rule);
    box-shadow: var(--vl-shadow);
  }
  .progress-track.before-plan .progress-fill,
  .progress-track.after-plan .progress-fill { width: 0 !important; }
  .progress-track.after-plan .progress-fill { width: 100% !important; }

  /* CURRENT PHASE HIGHLIGHT */
  .phase-block.current { position: relative; }
  .phase-block.current::after {
    content: 'NOW';
    position: absolute;
    top: 8px;
    right: 8px;
    font-size: 8px;
    letter-spacing: .12em;
    font-weight: 600;
    padding: 2px 6px;
    border-radius: 3px;
    background: var(--vl-ink);
    color: #fff;
  }

  /* VOLUME CHART TODAY MARKER */
  :global(.vol-today) {
    position: absolute;
    top: 0;
    bottom: 0;
    width: 2px;
    background: var(--vl-ink, #111110);
    transform: translateX(-50%);
    pointer-events: none;
    z-index: 2;
  }
  :global(.vol-today-dot) {
    position: absolute;
    top: -3px;
    left: 50%;
    transform: translateX(-50%);
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--vl-ink, #111110);
  }

  /* PHASE DETAIL */
  .phase-detail { display: none; grid-template-columns: 1fr 1fr 1fr; gap: 1px; background: var(--vl-rule); border: 1px solid var(--vl-rule); border-top: none; border-radius: 0 0 8px 8px; overflow: hidden; animation: fadeIn .25s ease; margin-top: -1px; box-shadow: var(--vl-shadow); }
  .phase-detail.visible { display: grid; }
  @keyframes fadeIn { from{opacity:0} to{opacity:1} }
  .dc { background: var(--vl-card); padding: 1.8rem 1.6rem; }
  .dl { font-size: 10px; letter-spacing: .15em; text-transform: uppercase; color: var(--vl-ink-3); margin-bottom: .9rem; font-weight: 500; }
  .zone-row { display: flex; align-items: center; gap: .7rem; margin-bottom: .65rem; }
  .zlbl { font-size: 11.5px; width: 1.8rem; color: var(--vl-ink-2); font-weight: 500; }
  .ztrack { flex: 1; height: 6px; background: var(--vl-bg); border-radius: 3px; overflow: hidden; }
  .zfill { height: 100%; border-radius: 3px; }
  .z1f{background:var(--vl-z1)} .z2f{background:var(--vl-z2)} .z3f{background:var(--vl-z3)}
  .zpct { font-size: 11.5px; width: 2.2rem; text-align: right; color: var(--vl-ink-2); font-weight: 500; }
  .pills { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: .4rem; }
  .pill { font-size: 11px; padding: .25rem .65rem; border: 1px solid var(--vl-rule); border-radius: 20px; color: var(--vl-ink-2); background: var(--vl-card); }
  .pill.p { border-color: var(--vl-ink-3); color: var(--vl-ink); font-weight: 500; }
  .kp { list-style: none; display: flex; flex-direction: column; gap: .6rem; }
  .kp li { font-size: 13px; color: var(--vl-ink-2); line-height: 1.55; padding-left: 1rem; position: relative; }
  .kp li::before { content:'–'; position:absolute; left:0; color:var(--vl-ink-3); }
  .bignum { font-family: var(--vl-font); font-size: 2.4rem; font-weight: 700; letter-spacing: -.02em; line-height: 1; margin-bottom: .2rem; }

  /* WEEK GRID */
  .week-grid { display: grid; grid-template-columns: repeat(7,1fr); gap: 1px; background: var(--vl-rule); border-radius: 8px; overflow: hidden; box-shadow: var(--vl-shadow); }
  .day { background: var(--vl-card); padding: 1.2rem .9rem; }
  .day.rest { background: var(--vl-card-alt); }
  .dname { font-size: 9px; letter-spacing: .12em; text-transform: uppercase; color: var(--vl-ink-3); margin-bottom: .6rem; font-weight: 500; }
  .ddot { width: 7px; height: 7px; border-radius: 50%; margin-bottom: .5rem; }
  .dd-z1{background:var(--vl-z1)} .dd-z3{background:var(--vl-z3)} .dd-r{background:var(--vl-rule)}
  .dtype { font-size: 12.5px; font-weight: 600; color: var(--vl-ink); margin-bottom: .25rem; line-height: 1.3; }
  .ddur { font-size: 11px; color: var(--vl-ink-3); margin-bottom: .35rem; font-weight: 500; }
  .dsport { font-size: 11.5px; color: var(--vl-ink-2); line-height: 1.45; }

  /* VOLUME CHART */
  :global(.vol-bars) { display: flex; align-items: flex-end; gap: 2px; height: 130px; padding-bottom: 18px; }
  :global(.vb) { flex: 1; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; height: 100%; position: relative; }
  :global(.vbar) { width: 100%; border-radius: 3px 3px 0 0; }
  :global(.vbar:hover) { opacity: .7; cursor: default; }
  :global(.vbar.dl) { opacity: .3; }
  :global(.race-marker) { position: absolute; top: 0; left: 50%; transform: translateX(-50%); display: flex; flex-direction: column; align-items: center; pointer-events: none; }
  :global(.rm-dot) { width: 7px; height: 7px; border-radius: 50%; margin-top: 1px; flex-shrink: 0; }
  :global(.rm-line) { width: 1px; flex: 1; opacity: .25; }
  .vol-phase-row { display: grid; grid-template-columns: 10fr 13fr 13fr 8fr 2fr; gap: 1px; margin-top: 6px; }
  .vpl { font-size: 10px; color: var(--vl-ink-3); padding: .3rem .2rem; text-align: center; font-weight: 500; }
  .vol-axis { display: flex; justify-content: space-between; font-size: 11px; color: var(--vl-ink-3); margin-top: .5rem; font-weight: 500; }
  .chart-legend { display: flex; gap: 1.5rem; margin-top: 1rem; flex-wrap: wrap; }
  .leg-item { display: flex; align-items: center; gap: .4rem; font-size: 11px; color: var(--vl-ink-2); }
  .leg-dot { width: 8px; height: 8px; border-radius: 50%; flex-shrink: 0; }

  /* PRINCIPLES */
  .principles { display: grid; grid-template-columns: repeat(3,1fr); gap: 1px; background: var(--vl-rule); border-radius: 8px; overflow: hidden; box-shadow: var(--vl-shadow); }
  .principle { background: var(--vl-card); padding: 1.8rem 1.6rem; }
  .pnum { font-family: var(--vl-font); font-size: 2.4rem; font-weight: 800; letter-spacing: -.02em; color: var(--vl-rule); line-height: 1; margin-bottom: .7rem; }
  .ptitle { font-size: 13.5px; font-weight: 600; margin-bottom: .5rem; color: var(--vl-ink); }
  .pbody { font-size: 12.5px; color: var(--vl-ink-2); line-height: 1.7; }

  /* FOOTER */
  .vl footer { padding: 1.8rem 4.5rem; border-top: 1px solid var(--vl-rule); display: flex; justify-content: space-between; font-size: 11px; color: var(--vl-ink-3); flex-wrap: wrap; gap: .5rem; font-weight: 500; }

  @media (max-width: 860px) {
    .vl header, .vl main, .vl footer { padding-left: 1.5rem; padding-right: 1.5rem; }
    .vl header { grid-template-columns: 1fr; }
    .header-right { text-align: left; }
    .stat-row, .race-calendar, .timeline { grid-template-columns: 1fr 1fr; }
    .phase-detail, .principles { grid-template-columns: 1fr; }
    .week-grid { grid-template-columns: repeat(4,1fr); }
    .vol-phase-row { display: none; }
  }
</style>

<script>
  const PLAN_START = new Date('2026-04-20');
  const PLAN_END   = new Date('2027-03-07');
  const today = new Date();
  today.setHours(0,0,0,0);

  const totalMs = PLAN_END.getTime() - PLAN_START.getTime();
  const elapsedMs = today.getTime() - PLAN_START.getTime();
  const pct = Math.max(0, Math.min(100, (elapsedMs / totalMs) * 100));
  const weekNum = Math.max(0, Math.floor(elapsedMs / (7 * 86400000)) + 1);

  // ── Current phase detection & auto-open ──
  const blocks = document.querySelectorAll<HTMLElement>('.phase-block');
  let currentPhaseId: string | null = null;

  blocks.forEach(block => {
    const start = new Date(block.dataset.start!);
    const end = new Date(block.dataset.end!);
    if (today >= start && today <= end) {
      block.classList.add('current');
      currentPhaseId = block.dataset.phase!;
    }
  });

  function openPhase(id: string) {
    blocks.forEach(b => b.classList.remove('active'));
    document.querySelectorAll('.phase-detail').forEach(d => d.classList.remove('visible'));
    const target = document.querySelector<HTMLElement>(`.phase-block[data-phase="${id}"]`);
    target?.classList.add('active');
    document.getElementById('detail-' + id)?.classList.add('visible');
  }

  // Auto-open current phase (or default to base)
  if (currentPhaseId) {
    openPhase(currentPhaseId);
  }

  // Click handlers
  blocks.forEach(block => {
    block.addEventListener('click', () => {
      openPhase(block.dataset.phase!);
    });
  });

  // ── Progress bar ──
  const track = document.getElementById('progressTrack')!;
  const fill = document.getElementById('progressFill')!;
  const needle = document.getElementById('progressNeedle')!;
  const label = document.getElementById('needleLabel')!;

  const monthNames = ['Jan','Feb','Mar','Apr','May','Jun','Jul','Aug','Sep','Oct','Nov','Dec'];
  const dateStr = `${today.getDate()} ${monthNames[today.getMonth()]} ${today.getFullYear()}`;

  if (today < PLAN_START) {
    track.classList.add('before-plan');
    needle.style.left = '0%';
    label.textContent = `${dateStr} · starts in ${Math.ceil((PLAN_START.getTime() - today.getTime()) / 86400000)}d`;
  } else if (today > PLAN_END) {
    track.classList.add('after-plan');
    fill.style.width = '100%';
    needle.style.left = '100%';
    label.textContent = `${dateStr} · plan complete`;
  } else {
    fill.style.width = `${pct}%`;
    needle.style.left = `${pct}%`;
    label.textContent = `Today · ${dateStr} · Week ${weekNum} of 46`;
  }

  // ── Volume chart ──
  (function() {
    const phases = [
      {weeks:10, color:'#3a7abf', avg:7.0, sp:.8},
      {weeks:13, color:'#2d8a55', avg:8.4, sp:.9},
      {weeks:13, color:'#6355c7', avg:8.6, sp:.7},
      {weeks:8,  color:'#c06030', avg:7.6, sp:.5},
      {weeks:2,  color:'#8b3a62', avg:4.2, sp:.6},
    ];
    const races: Record<number, {color: string; label: string}> = {
      39: {color:'#c06030', label:'La Diagonela'},
      41: {color:'#8b3a62', label:'Marcialonga'},
      45: {color:'#1a1a18', label:'Vasaloppet'},
    };
    const maxH = 112, maxV = 10.5, totalWeeks = 46;
    const container = document.getElementById('volBars');
    if (!container) return;
    container.style.position = 'relative';
    let wi = 0;

    phases.forEach(ph => {
      for (let i = 0; i < ph.weeks; i++) {
        const isDeload = (i + 1) % 4 === 0;
        const raw = isDeload ? ph.avg * 0.65 : ph.avg + (Math.random()-.5)*ph.sp;
        const vol = Math.max(3, Math.min(11, raw));
        const h = Math.round((vol/maxV)*maxH);

        const wrap = document.createElement('div');
        wrap.className = 'vb';
        wrap.title = `Wk ${wi+1}: ~${vol.toFixed(1)} hrs${isDeload?' (recovery)':''}`;

        const bar = document.createElement('div');
        bar.className = 'vbar' + (isDeload ? ' dl' : '');
        bar.style.cssText = `height:${h}px;background:${ph.color}`;
        wrap.appendChild(bar);

        if (races[wi]) {
          const r = races[wi];
          const mk = document.createElement('div');
          mk.className = 'race-marker';
          mk.title = r.label;
          const dot = document.createElement('div');
          dot.className = 'rm-dot';
          dot.style.background = r.color;
          const line = document.createElement('div');
          line.className = 'rm-line';
          line.style.cssText = `background:${r.color};height:${h-8}px`;
          mk.appendChild(dot);
          mk.appendChild(line);
          wrap.appendChild(mk);
        }

        container.appendChild(wrap);
        wi++;
      }
    });

    // Today marker on volume chart
    if (today >= PLAN_START && today <= PLAN_END) {
      const todayWeek = elapsedMs / (7 * 86400000); // fractional week
      const pctVol = (todayWeek / totalWeeks) * 100;
      const marker = document.createElement('div');
      marker.className = 'vol-today';
      marker.style.left = `${pctVol}%`;
      marker.title = `Today · Week ${weekNum}`;
      const dot = document.createElement('div');
      dot.className = 'vol-today-dot';
      marker.appendChild(dot);
      container.appendChild(marker);
    }
  })();
</script>
